# Application
NODE_ENV=production
PORT=3000
APP_NAME=RoyalBet
APP_URL=https://royalbet.com

# Database
DATABASE_URL=postgresql://royalbet:development_password@postgres:5432/royalbet
DATABASE_POOL_SIZE=100
DATABASE_TIMEOUT=30000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=development_password
REDIS_DB=0

# JWT
JWT_SECRET=super_secret_jwt_key_development_only
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# WebSocket
WS_PATH=/socket.io
WS_CORS_ORIGIN=https://royalbet.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Payment Gateway
RAZORPAY_KEY_ID=test_id
RAZORPAY_KEY_SECRET=test_secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=testpass
EMAIL_FROM=noreply@royalbet.com

# Admin
ADMIN_EMAILS=admin@royalbet.com,superadmin@royalbet.com

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
